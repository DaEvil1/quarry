# --- database: the standard PostgreSQL settings, read directly by psycopg/libpq ---------------------------
# DigitalOcean: Databases > your cluster > Connection details (user and database "quarry").
# Add the droplet under "Trusted sources".
PGHOST=your-cluster-do-user-0000000-0.b.db.ondigitalocean.com
PGPORT=25060
PGDATABASE=quarry
PGUSER=quarry
# No URL encoding. Single quotes preserve literal dollar signs in Compose .env files.
PGPASSWORD='PASSWORD'
PGSSLMODE=require
PGCONNECT_TIMEOUT=10
# ...or instead one URL (it wins when set; special characters in the password must be URL-encoded):
# QUARRY_DATABASE_URL=postgresql://quarry:PASSWORD@host:25060/quarry?sslmode=require

# --- required ---------------------------------------------------------------------------------------------
# The address people open. Passkeys are bound to this host name: changing it later means registering new
# passkeys (sign in with a recovery code, then add them under Settings).
QUARRY_BASE_URL=https://quarry.daevil1.com
# Lets the first visitor create the first user and passkey at /setup; ignored once a user exists.
# Generate once: python3 -c "import secrets; print(secrets.token_urlsafe(24))". You may remove it after setup.
QUARRY_SETUP_TOKEN=

# --- tuning -----------------------------------------------------------------------------------------------
# connections kept open to the database (managed clusters have a small limit)
QUARRY_DB_POOL=3
